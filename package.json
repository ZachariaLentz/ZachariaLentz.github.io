{
  "private": true,
  "name": "portfolio",
  "homepage": "https://zacharia.dev",
  "version": "1.0.0",
  "scripts": {
    "build": "react-scripts build",
    "postbuild": "node scripts/generate-static-site.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -b gh-pages -d build",
    "eject": "react-scripts eject",
    "start": "react-scripts start",
    "test": "react-scripts test --watchAll=false",
    "lint": "eslint src/App.js src/App.test.js src/setupTests.js src/index.js src/global.js src/theme.js src/portfolio.js src/containers/Main.js src/components/header/Header.js src/components/footer/Footer.js src/components/site/*.js src/pages/home/HomeComponent.js src/pages/experience/Experience.js src/pages/contact/ContactComponent.js src/pages/case-studies/*.js src/pages/credentials/CredentialsPage.js src/pages/errors/error404/Error.js",
    "check:content": "node scripts/check-content.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "format": "prettier --write src"
  },
  "dependencies": {
    "gh-pages": "^6.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.4",
    "react-router": "^7.18.4",
    "styled-components": "^6.1.0"
  },
  "devDependencies": {
    "@iconify/icons-logos": "^1.2.8",
    "@iconify/react": "^4.1.1",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "react-scripts": "5.0.1",
    "sharp": "^0.34.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": "react-app"
  }
}
